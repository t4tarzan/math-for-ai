# App URL (local dev uses port 7790 — avoids 3000 clashes with other AI tools)
NEXT_PUBLIC_APP_URL=http://localhost:7790
# Production: https://math.wntap.org

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://m4ai:m4ai@localhost:5433/m4ai

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth (optional — set NEXT_PUBLIC_GITHUB_ENABLED=true when configured)
GITHUB_ID=
GITHUB_SECRET=
NEXT_PUBLIC_GITHUB_ENABLED=false

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
